#include <windows.h>
#include "resource.h"
#include "version.h"

// First icon in the file is what Explorer shows for the exe.
IDI_APP ICON "PSCam4Win.ico"

// The settings window is laid out in code (host/ui/SettingsWindow.cpp). This
// shell exists so the dialog manager still handles Tab, Esc and mnemonics
// through the main message loop's IsDialogMessageW; the size here is a
// placeholder that the first layout replaces.
IDD_SETTINGS DIALOGEX 0, 0, 400, 300
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "PSCam4Win"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PSCAM_VERSION_COMMA
 PRODUCTVERSION PSCAM_VERSION_COMMA
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PSCam4Win"
            VALUE "FileDescription",  "PSCam4Win Virtual Camera"
            VALUE "FileVersion",      PSCAM_VERSION_STRING
            VALUE "InternalName",     "PSCam4WinTray"
            VALUE "OriginalFilename", "PSCam4WinTray.exe"
            VALUE "ProductName",      "PSCam4Win Virtual Camera"
            VALUE "ProductVersion",   PSCAM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
